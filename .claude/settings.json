{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.clooks/bin/entrypoint.sh"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.clooks/bin/entrypoint.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.clooks/bin/entrypoint.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "CLOOKS_APPROVAL_PROTOCOL=1 CLOOKS_APPROVAL_OWNER=project:ce0a4cfa47c6b6676e7c84a5014187f8 CLOOKS_APPROVAL_DISPOSITION=run CLOOKS_AGENT=claude-code \"$CLAUDE_PROJECT_DIR\"/.clooks/bin/entrypoint.sh",
            "timeout": 2147483
          },
          {
            "type": "mcp_tool",
            "server": "clooks",
            "tool": "check",
            "timeout": 2147483,
            "input": {
              "protocol": 1,
              "agent": "claude-code",
              "owner": "project:ce0a4cfa47c6b6676e7c84a5014187f8",
              "session_id": "${session_id}",
              "tool_use_id": "${tool_use_id}"
            }
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.clooks/bin/entrypoint.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.clooks/bin/entrypoint.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
