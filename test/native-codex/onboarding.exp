#!/usr/bin/expect -f

# Real TUI trust, then exact prompt/final-response pairs. No trust-state writes.
set timeout 60
if {$argc < 4 || ($argc - 2) % 2 != 0 || ![info exists env(CLOOKS_E2E_DOCKER)]} {
    puts stderr "Expected review choice, transcript path and prompt/response pairs in Docker"
    exit 64
}
proc abort_child {message} {
    global spawn_id
    puts stderr $message
    catch {exec /bin/kill -KILL [exp_pid -i $spawn_id]}
    catch {close -i $spawn_id}
    catch {wait -i $spawn_id}
    exit 70
}
set review [lindex $argv 0]
set stty_init "rows 50 columns 220"
log_file -noappend [lindex $argv 1]
spawn -noecho /native/bin/codex --no-alt-screen --sandbox danger-full-access --ask-for-approval never
set launch [open [file join [file dirname [lindex $argv 1]] native.launched.json] {WRONLY CREAT EXCL}]
puts $launch [format {{"pid":%d}} [exp_pid -i $spawn_id]]
close $launch
trap {abort_child "Onboarding PTY interrupted"} {SIGTERM SIGINT}
match_max 262144
expect_before {
    -exact "\033\[6n" {send -- "\033\[1;1R"; exp_continue}
}
if {$review ne "none"} {
    expect {
        -exact "Hooks need review" {}
        timeout {abort_child "No native hook-review modal"}
        eof {abort_child "Codex exited before hook review"}
    }
    after 300
    if {$review eq "accept"} {
        send -- "2"
    } elseif {$review eq "decline"} {
        send -- "3"
    } else {
        abort_child "Unknown hook review choice"
    }
    after 200
    send -- "\r"
    puts "ONBOARDING_TRUST_CHOICE=$review"
}
after 1200
foreach {prompt response} [lrange $argv 2 end] {
    send -- "\033\[200~${prompt}\033\[201~"
    after 200
    send -- "\r"
    expect {
        -exact $response {}
        -exact "Hooks need review" {abort_child "Unexpected additional hook review"}
        timeout {abort_child "Timed out waiting for final response: $response"}
        eof {abort_child "Codex exited before final response: $response"}
    }
    after 700
}
send -- "/quit"
after 200
send -- "\r"
expect {
    eof {}
    timeout {abort_child "Codex did not quit"}
}
set result [wait -i $spawn_id]
if {[llength $result] != 4 || [lindex $result 2] != 0 || [lindex $result 3] != 0} {
    puts stderr "Abnormal native exit: $result"
    exit 70
}
puts "ONBOARDING_NATIVE_EXIT_ZERO"
