#!/usr/bin/expect -f

# Arguments are a binary, scope (or pick), agent (or auto), action (or none), then prompt/response pairs.
set timeout 8
if {$argc < 4 || ($argc - 4) % 2 != 0} {
    puts stderr "Expected binary scope agent action and prompt/response pairs"
    exit 64
}
if {![info exists env(CLOOKS_E2E_DOCKER)] || $env(CLOOKS_E2E_DOCKER) ne "true"} {
    puts stderr "Uninstall PTY tests require the Docker test container"
    exit 64
}

proc abort_child {message} {
    global spawn_id
    puts stderr $message
    catch {exec /bin/kill -KILL [exp_pid -i $spawn_id]}
    catch {close -i $spawn_id}
    catch {wait -i $spawn_id}
    exit 70
}

set stty_init "rows 40 columns 1024"
set command [list [lindex $argv 0] uninstall]
if {[lindex $argv 1] ne "pick"} { lappend command --[lindex $argv 1] }
if {[lindex $argv 2] ne "auto"} { lappend command --agent [lindex $argv 2] }
if {[lindex $argv 3] ne "none"} { lappend command [lindex $argv 3] }
spawn -noecho {*}$command
trap {abort_child "PTY driver interrupted"} {SIGTERM SIGINT}
match_max 65536
foreach {prompt response} [lrange $argv 4 end] {
    expect {
        -exact $prompt {}
        timeout {abort_child "Timed out waiting for prompt: $prompt"}
        eof {abort_child "CLI exited before prompt: $prompt"}
    }
    switch -- $response {
        yes {send -- "y"}
        no {send -- "n"}
        cancel {send -- "\003"}
        first {send -- "\r"}
        second {send -- "\033\[B\r"}
        third {send -- "\033\[B\033\[B\r"}
        default {abort_child "Unknown response: $response"}
    }
}
expect {
    eof {}
    timeout {abort_child "CLI did not exit after final answer"}
}
set result [wait -i $spawn_id]
if {[lindex $result 2] != 0 || [llength $result] != 4} {
    puts stderr "Abnormal CLI termination: $result"
    exit 70
}
if {[lindex $result 3] != 0} {
    puts stderr "CLI exit status: [lindex $result 3]"
    exit 70
}
puts "PTY journey completed with CLI exit 0"
